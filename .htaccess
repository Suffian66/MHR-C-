
Options -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Do not rewrite the SEO controller
    RewriteRule ^seo\.php$ - [L]

    # Keep login working directly through React
    RewriteRule ^login/?$ index.html [L]

    # Serve existing files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Homepage
    RewriteRule ^$ seo.php?route=/ [L,QSA]

    # All other React routes
    RewriteRule ^(.+)$ seo.php?route=/$1 [L,QSA]

</IfModule>
